/* ---------- helpers ---------- */
const $ = s => document.querySelector(s);
const toFa = n => String(n).replace(/\d/g, d => '۰۱۲۳۴۵۶۷۸۹'[d]);
const clamp = (v,a,b) => Math.min(b, Math.max(a, v));
const esc = s => s.replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const CANON = 'https://maghze.ir/blog/what-is-ai';

/* ---------- toast system ---------- */
const toastBox = $('#toasts');
function toast(msg){
  if (toastBox.children.length >= 3) toastBox.firstElementChild.remove();
  const t = document.createElement('div');
  t.className = 'toast';
  t.innerHTML = '<span class="dot" aria-hidden="true"></span><span></span>';
  t.lastElementChild.textContent = msg;
  toastBox.appendChild(t);
  setTimeout(() => { t.classList.add('out'); setTimeout(() => t.remove(), 320); }, 3400);
}

/* ---------- demo-page links ---------- */
document.querySelectorAll('[data-nav]').forEach(el => {
  el.addEventListener('click', e => {
    e.preventDefault();
    toast(`صفحهٔ «${el.dataset.nav}» بخشی از این پیش‌نمایش است.`);
  });
});

/* ---------- header state + mobile menu ---------- */
const header = $('#siteHeader'), burger = $('#menuToggle'), mobileMenu = $('#mobileMenu');
burger.addEventListener('click', () => {
  const open = header.classList.toggle('menu-open');
  burger.classList.toggle('open', open);
  burger.setAttribute('aria-expanded', open);
});
mobileMenu.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
  header.classList.remove('menu-open'); burger.classList.remove('open'); burger.setAttribute('aria-expanded','false');
}));
document.addEventListener('keydown', e => {
  if (e.key === 'Escape') {
    header.classList.remove('menu-open'); burger.classList.remove('open'); burger.setAttribute('aria-expanded','false');
  }
});

/* ---------- automatic TOC: built from real headings ---------- */
const heads = Array.from(document.querySelectorAll('.post-body h2, .post-body h3'));
const tocList = $('#tocList'), tocMobileList = $('#tocMobileList');
heads.forEach((h, i) => {
  h.id = 'sec-' + (i + 1);
  const a = document.createElement('a');
  a.href = '#' + h.id;
  a.className = h.tagName === 'H3' ? 'lvl-3' : 'lvl-2';
  a.appendChild(Object.assign(document.createElement('span'), { textContent: h.textContent }));
  tocList.appendChild(document.createElement('li')).appendChild(a);
  tocMobileList.appendChild(document.createElement('li')).appendChild(a.cloneNode(true));
});
let links = [...tocList.querySelectorAll('a')];
let mLinks = [...tocMobileList.querySelectorAll('a')];

tocMobileList.addEventListener('click', () => { $('#tocMobile').removeAttribute('open'); });

/* ---------- reading time (computed from actual text) ---------- */
const body = $('#postBody');
{
  const clone = body.cloneNode(true);
  clone.querySelectorAll('.toc-mobile, .reading-tools, .prompt-card, .table-wrap, .tags, .share, .author-box').forEach(n => n.remove());
  const words = clone.textContent.trim().split(/\s+/).length;
  $('#readTime').textContent = toFa(Math.max(1, Math.round(words / 160))) + ' دقیقه مطالعه';
}

/* ---------- scroll engine: progress bar, scroll-spy, TOC fill ---------- */
const fill = $('#progressFill'), tocFill = $('#tocFill'),
      rtPct = $('#rtPct'), tocPct = $('#tocPct'), rtBar = $('#rtBarFill'),
      art = $('#article'), toTop = $('#toTop');

function update(){
  const y = window.scrollY, vh = innerHeight;
  header.classList.toggle('scrolled', y > 8);
  toTop.classList.toggle('show', y > 700);

  const start = art.offsetTop;
  const total = art.offsetHeight - vh;
  const p = total > 0 ? clamp((y - start) / total, 0, 1) : 1;
  const pct = Math.round(p * 100);
  fill.style.width = pct + '%';
  rtBar.style.width = pct + '%';
  rtPct.textContent = toFa(pct) + '٪';
  tocPct.textContent = toFa(pct) + '٪';

  let cur = 0;
  for (let i = 0; i < heads.length; i++) {
    if (heads[i].getBoundingClientRect().top <= 160) cur = i;
  }
  if (y + vh >= document.documentElement.scrollHeight - 80) cur = heads.length - 1;

  [links, mLinks].forEach(list => list.forEach((a, i) => {
    a.classList.toggle('is-active', i === cur);
    a.classList.toggle('is-done', i < cur);
  }));
  const li = links[cur] && links[cur].parentElement;
  if (li) tocFill.style.height = (li.offsetTop + li.offsetHeight / 2) + 'px';
}
let ticking = false;
addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(() => { update(); ticking = false; }); } }, { passive: true });
addEventListener('resize', update);
update();

toTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

/* ---------- font-size control (accessibility) ---------- */
const steps = [0.92, 1, 1.1, 1.22];
let si = 1;
const fsVal = $('#fsVal'), dec = $('#fsDec'), inc = $('#fsInc');
function applyFs(){
  document.documentElement.style.setProperty('--fs', steps[si]);
  fsVal.textContent = toFa(Math.round(steps[si] * 100)) + '٪';
  dec.disabled = si === 0;
  inc.disabled = si === steps.length - 1;
}
dec.addEventListener('click', () => { si = Math.max(0, si - 1); applyFs(); });
inc.addEventListener('click', () => { si = Math.min(steps.length - 1, si + 1); applyFs(); });
applyFs();

/* ---------- copy buttons (prompt card, etc.) ---------- */
document.querySelectorAll('.copy-btn').forEach(btn => btn.addEventListener('click', async () => {
  const box = btn.closest('.prompt-card, .code-card');
  const text = box.querySelector('.copy-target, pre').innerText;
  try { await navigator.clipboard.writeText(text); }
  catch {
    const ta = Object.assign(document.createElement('textarea'), { value: text });
    document.body.appendChild(ta); ta.select(); document.execCommand('copy'); ta.remove();
  }
  toast('در کلیپ‌بورد کپی شد.');
}));

/* ---------- share ---------- */
{
  const u = encodeURIComponent(CANON), t = encodeURIComponent(document.title);
  $('#shTg').href = `https://t.me/share/url?url=${u}&text=${t}`;
  $('#shX').href  = `https://twitter.com/intent/tweet?url=${u}&text=${t}`;
  $('#shLink').addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(CANON); toast('لینک مقاله کپی شد.'); }
    catch { toast('کپی لینک ممکن نشد.'); }
  });
}

/* ---------- live search with local index ---------- */
const ARTICLES = [
  { t: 'هوش مصنوعی چیست؟ راهنمای ساده برای شروع', c: 'مقالات پایه', self: true },
  { t: 'تفاوت هوش مصنوعی، یادگیری ماشین و یادگیری عمیق به زبان ساده', c: 'مقالات پایه', target: 'rel-1' },
  { t: '۵ دستیار هوش مصنوعی رایگان برای کارهای روزمره', c: 'ابزارها', target: 'rel-2' },
  { t: 'هنر سؤال پرسیدن از هوش مصنوعی؛ چطور جواب بهتر بگیریم؟', c: 'آموزش', target: 'rel-3' },
  { t: 'یادگیری ماشین چیست؟ آموزش کامپیوتر با مثال', c: 'آموزش' },
  { t: 'چت‌بات چیست و چطور کار می‌کند؟', c: 'مقالات پایه' },
  { t: 'هوش مصنوعی در زندگی روزمره؛ از گوشی تا خانهٔ هوشمند', c: 'اخبار' },
  { t: 'معرفی ChatGPT؛ اولین دستیار هوشمند شما', c: 'آموزش' },
];

function attachSearch(form){
  const input = form.querySelector('input');
  const panel = document.createElement('div');
  panel.className = 'search-results';
  panel.hidden = true;
  form.appendChild(panel);

  const rx = q => new RegExp(q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'g');

  function go(item){
    panel.hidden = true; input.value = ''; input.blur();
    if (item.self) { window.scrollTo({ top: 0, behavior: 'smooth' }); return; }
    if (item.target) {
      const card = document.getElementById(item.target);
      card.scrollIntoView({ behavior: 'smooth', block: 'center' });
      card.classList.remove('flash'); void card.offsetWidth; card.classList.add('flash');
      setTimeout(() => card.classList.remove('flash'), 1700);
      return;
    }
    toast(`مقالهٔ «${item.t}» در نسخهٔ نمایشی در دسترس نیست.`);
  }

  input.addEventListener('input', () => {
    const q = input.value.trim();
    if (!q) { panel.hidden = true; return; }
    const res = ARTICLES.filter(a => a.t.includes(q) || a.c.includes(q)).slice(0, 5);
    panel.innerHTML = res.length
      ? res.map(a => {
          const hi = esc(a.t).replace(rx(esc(q)), m => `<mark>${m}</mark>`);
          return `<button type="button" data-i="${ARTICLES.indexOf(a)}"><span class="sr-cat">${esc(a.c)}</span><span class="sr-title">${hi}</span></button>`;
        }).join('')
      : '<div class="sr-empty">نتیجه‌ای یافت نشد</div>';
    panel.hidden = false;
  });

  panel.addEventListener('click', e => {
    const b = e.target.closest('button[data-i]');
    if (b) go(ARTICLES[+b.dataset.i]);
  });

  form.addEventListener('submit', e => {
    e.preventDefault();
    const q = input.value.trim();
    if (!q) { toast('عبارتی برای جستجو وارد کنید.'); return; }
    const first = ARTICLES.find(a => a.t.includes(q) || a.c.includes(q));
    if (first) go(first);
    else toast(`نتیجه‌ای برای «${q}» یافت نشد.`);
  });

  input.addEventListener('keydown', e => { if (e.key === 'Escape') { panel.hidden = true; input.blur(); } });
  document.addEventListener('click', e => { if (!form.contains(e.target)) panel.hidden = true; });
  return input;
}
const headerInput = attachSearch($('#searchFormHeader'));
attachSearch($('#searchFormMobile'));

/* keyboard shortcut: "/" focuses search */
document.addEventListener('keydown', e => {
  if (e.key === '/' && !/INPUT|TEXTAREA/.test(document.activeElement.tagName)) {
    e.preventDefault();
    (headerInput || $('#searchFormMobile input')).focus();
  }
});

/* ---------- reveal on scroll ---------- */
const io = new IntersectionObserver(entries => entries.forEach(en => {
  if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); }
}), { threshold: 0.12 });
document.querySelectorAll('.reveal').forEach(el => io.observe(el));

})();
</script>
</body>
</html>