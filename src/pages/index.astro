            </span>
          </div>
        </header>

        <figure class="post-cover">
          <div class="frame">
            <img src="https://picsum.photos/seed/maghze-llm/1600/700.jpg" width="1600" height="700" alt="نمایی مفهومی از شبکه‌های عصبی و جریان داده">
          </div>
          <figcaption>نمایی مفهومی از جریان داده در معماری ترنسفورمر — تصویر: مغزه</figcaption>
        </figure>
      </div>
    </div>

    <!-- Body + TOC -->
    <div class="container">
      <div class="post-layout">

        <div class="post-body" id="postBody">

          <!-- Reader tools -->
          <div class="reading-tools">
