<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#09090b">
<meta name="description" content="مغزه — رسانهٔ تخصصی هوش مصنوعی فارسی. آموزش، اخبار و ابزارهای AI به زبان ساده.">
<title>مدل‌های زبانی بزرگ چگونه کار می‌کنند؟ | مغزه</title>

<!-- Vazirmatn via CDN -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@100..900&display=swap" rel="stylesheet">

<style>
/* ============================================================
   1. Design Tokens
============================================================ */
:root{
  --bg:#09090b;
  --surface:#131316;
  --surface-2:#1b1b20;
  --border:rgba(255,255,255,.07);
  --border-2:rgba(255,255,255,.14);
  --text:#f4f4f6;
  --text-2:#c9c9d1;
  --muted:#8e8e99;
  --purple:#a855f7;
  --blue:#3b82f6;
  --indigo:#6366f1;
  --grad:linear-gradient(100deg,var(--purple),var(--indigo) 52%,var(--blue));
  --grad-soft:linear-gradient(100deg,rgba(168,85,247,.14),rgba(59,130,246,.14));
  --radius:16px;
  --header-h:68px;
  --fs:1; /* article font-scale (controlled by reader) */
}

/* ============================================================
   2. Base / Reset
============================================================ */
*,*::before,*::after{box-sizing:margin-box;box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:100px}
body{
  margin:0;
  font-family:"Vazirmatn",Tahoma,sans-serif;
  background:var(--bg);
  color:var(--text-2);
  font-size:1rem;
  line-height:1.9;
  overflow-x:clip;
  -webkit-font-smoothing:antialiased;
}
img{display:block;max-width:100%}
a{color:inherit;text-decoration:none}
button{font-family:inherit}
::selection{background:rgba(168,85,247,.4);color:#fff}
::-webkit-scrollbar{width:10px;height:8px}
::-webkit-scrollbar-track{background:var(--bg)}
::-webkit-scrollbar-thumb{background:#27272a;border-radius:99px}
::-webkit-scrollbar-thumb:hover{background:#3f3f46}
:focus-visible{outline:2px solid var(--purple);outline-offset:2px;border-radius:6px}

.container{max-width:1180px;margin-inline:auto;padding-inline:clamp(16px,4vw,28px)}
.grad-text{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-fill-color:transparent}
mark{background:rgba(168,85,247,.35);color:#fff;border-radius:3px;padding:0 2px}

.skip-link{
  position:fixed;top:-60px;inset-inline-start:16px;z-index:2000;
  background:var(--surface-2);color:#fff;padding:10px 18px;border-radius:10px;
  border:1px solid var(--border-2);transition:top .25s;
}
.skip-link:focus{top:12px}

@keyframes fadeUp{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:none}}

/* ============================================================
   3. Reading Progress Bar (top of viewport)
============================================================ */
.progress{position:fixed;top:0;inset-inline:0;height:3px;z-index:1200;pointer-events:none}
.progress span{display:block;height:100%;width:0;background:var(--grad);box-shadow:0 0 12px rgba(168,85,247,.8)}

/* ============================================================
   4. Global Header (Glassmorphism)
============================================================ */
.site-header{
  position:sticky;top:0;z-index:1000;
  background:rgba(9,9,11,.72);
  backdrop-filter:blur(18px) saturate(1.4);
  -webkit-backdrop-filter:blur(18px) saturate(1.4);
  border-bottom:1px solid var(--border);
  transition:background .3s,box-shadow .3s;
}
.site-header.scrolled{background:rgba(9,9,11,.9);box-shadow:0 12px 32px -18px rgba(0,0,0,.9)}
.header-inner{display:flex;align-items:center;gap:24px;height:var(--header-h)}

.logo{display:flex;align-items:center;gap:10px;flex-shrink:0}
.logo-brain{font-size:1.55rem;line-height:1;animation:brainPulse 3.2s ease-in-out infinite}
@keyframes brainPulse{0%,100%{transform:scale(1)}50%{transform:scale(1.14)}}
.logo-text{font-size:1.6rem;font-weight:900;line-height:1}
.logo-domain{
  font-size:.62rem;font-weight:600;letter-spacing:.06em;color:var(--muted);
  border:1px solid var(--border);border-radius:99px;padding:2px 9px;align-self:center;
}

.main-nav{display:flex;gap:4px;margin-inline-start:16px}
.main-nav a{
  position:relative;padding:8px 14px;border-radius:10px;
  font-size:.92rem;font-weight:500;color:var(--text-2);transition:color .25s,background .25s;
}
.main-nav a:hover{color:#fff;background:rgba(255,255,255,.05)}
.main-nav a.active{color:transparent;background:transparent}
.main-nav a.active::before{
  content:'';position:absolute;inset:6px 8px;border-radius:9px;z-index:-1;
  background:var(--grad);opacity:.13;
}
.main-nav a.active{background:var(--grad);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}

/* Search */
.search-box{
  position:relative;display:flex;align-items:center;gap:9px;
  margin-inline-start:auto;width:240px;
  background:rgba(255,255,255,.05);border:1px solid var(--border);
  border-radius:12px;padding:8px 13px;color:var(--muted);
  transition:border-color .25s,box-shadow .25s,background .25s;
}
.search-box:focus-within{
  border-color:rgba(168,85,247,.55);background:rgba(255,255,255,.07);
  box-shadow:0 0 0 3px rgba(168,85,247,.14);
}
.search-box input{flex:1;min-width:0;background:none;border:0;outline:none;color:var(--text);font:inherit;font-size:.88rem}
.search-box input::placeholder{color:var(--muted)}
.search-box svg{flex-shrink:0}
kbd{
  font-family:inherit;font-size:.7rem;color:var(--muted);
  background:rgba(255,255,255,.07);border:1px solid var(--border-2);
  border-radius:5px;padding:1px 8px;
}
.search-results{
  position:absolute;top:calc(100% + 10px);inset-inline:0;min-width:290px;
  background:rgba(19,19,22,.97);backdrop-filter:blur(16px);
  border:1px solid var(--border-2);border-radius:14px;padding:6px;
  box-shadow:0 24px 60px -20px rgba(0,0,0,.85);z-index:60;max-height:320px;overflow:auto;
}
.search-results[hidden]{display:none}
.search-results button{
  display:flex;flex-direction:column;gap:2px;width:100%;text-align:start;
  background:none;border:0;border-radius:10px;padding:9px 12px;cursor:pointer;
  color:var(--text-2);transition:background .2s,color .2s;
}
.search-results button:hover{background:rgba(168,85,247,.1);color:#fff}
.sr-cat{font-size:.68rem;color:var(--purple);font-weight:600}
.sr-title{font-size:.85rem;line-height:1.7}
.sr-empty{padding:14px;text-align:center;color:var(--muted);font-size:.85rem}

/* Hamburger + mobile menu */
.menu-toggle{
  display:none;position:relative;width:42px;height:42px;margin-inline-start:auto;
  background:rgba(255,255,255,.04);border:1px solid var(--border);border-radius:11px;cursor:pointer;
}
.menu-toggle span{
  position:absolute;inset-inline-start:11px;width:19px;height:2px;border-radius:2px;
  background:var(--text);transition:transform .3s,top .3s;
}
.menu-toggle span:nth-child(1){top:15px}
.menu-toggle span:nth-child(2){top:24px}
.menu-toggle.open span:nth-child(1){top:19px;transform:rotate(45deg)}
.menu-toggle.open span:nth-child(2){top:19px;transform:rotate(-45deg)}

.mobile-menu{overflow:hidden;max-height:0;transition:max-height .38s ease;border-top:1px solid transparent}
.site-header.menu-open .mobile-menu{max-height:440px;border-top-color:var(--border)}
.mobile-menu nav{display:flex;flex-direction:column;padding:10px 0 18px}
.mobile-menu nav a{padding:12px 4px;font-size:1rem;color:var(--text-2);border-bottom:1px dashed var(--border)}
.mobile-menu nav a:hover{color:#fff}
.mobile-menu .search-box{width:100%;margin:18px 0 0}

/* ============================================================
   5. Article Hero
============================================================ */
.post-head{position:relative}
.hero-glow{
  position:absolute;inset:0;pointer-events:none;
  background:
    radial-gradient(560px 300px at 78% 0%,rgba(168,85,247,.13),transparent 70%),
    radial-gradient(520px 280px at 18% 8%,rgba(59,130,246,.11),transparent 70%);
}
.post-head .container{position:relative}

.breadcrumb{padding-top:22px;font-size:.82rem;color:var(--muted);display:flex;gap:8px;flex-wrap:wrap;animation:fadeUp .6s both}
.breadcrumb a:hover{color:var(--text)}
.breadcrumb [aria-current]{color:var(--text-2)}

.post-hero{text-align:center;max-width:860px;margin:36px auto 0}
.post-hero>*{animation:fadeUp .7s cubic-bezier(.2,.7,.2,1) both}
.post-badges{display:flex;justify-content:center;gap:10px;animation-delay:.05s}
.badge{
  display:inline-flex;align-items:center;gap:7px;
  font-size:.78rem;font-weight:600;color:#fff;
  padding:6px 15px;border-radius:99px;
  background:var(--grad-soft);border:1px solid rgba(168,85,247,.4);
  transition:border-color .25s,box-shadow .25s;
}
.badge::before{content:'';width:7px;height:7px;border-radius:50%;background:var(--grad)}
.badge:hover{border-color:var(--purple);box-shadow:0 0 18px -4px rgba(168,85,247,.6)}
.badge.ghost{background:none;border-color:var(--border-2);color:var(--text-2)}
.badge.ghost::before{display:none}

.post-title{
  font-size:clamp(1.7rem,4.6vw,2.7rem);font-weight:900;color:var(--text);
  line-height:1.55;margin:22px 0 16px;animation-delay:.12s;
}
.post-lead{font-size:1.1rem;line-height:2.1;color:var(--text-2);margin:0 0 26px;animation-delay:.2s}

.post-meta{
  display:flex;justify-content:center;align-items:center;gap:18px;flex-wrap:wrap;
  font-size:.86rem;color:var(--muted);animation-delay:.28s;
}
.meta-author{display:inline-flex;align-items:center;gap:10px;color:var(--text-2);font-weight:600}
.avatar{
  width:36px;height:36px;border-radius:50%;display:grid;place-items:center;
  background:var(--grad);color:#fff;font-weight:800;font-size:1rem;
}
.meta-item{display:inline-flex;align-items:center;gap:7px}
.meta-sep{width:4px;height:4px;border-radius:50%;background:#3f3f46}

.post-cover{margin:38px 0 0;animation:fadeUp .8s .35s cubic-bezier(.2,.7,.2,1) both}
.post-cover .frame{
  border:1px solid var(--border);border-radius:20px;overflow:hidden;
  box-shadow:0 30px 90px -40px rgba(99,102,241,.4);
}
.post-cover img{width:100%;aspect-ratio:21/9;object-fit:cover}
.post-cover figcaption{text-align:center;font-size:.8rem;color:var(--muted);margin-top:12px}

/* ============================================================
   6. Article Layout: body + sticky TOC sidebar
============================================================ */
.post-layout{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:56px;align-items:start;margin-top:54px}

/* --- Reading tools --- */
.reading-tools{
  display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap;
  background:var(--surface);border:1px solid var(--border);border-radius:14px;
  padding:10px 16px;margin-bottom:38px;
}
.rt-group{display:flex;align-items:center;gap:9px}
.rt-label{font-size:.84rem;color:var(--muted)}
.rt-btn{
  width:32px;height:32px;display:grid;place-items:center;cursor:pointer;
  background:var(--surface-2);border:1px solid var(--border);border-radius:9px;
  color:var(--text-2);transition:border-color .25s,color .25s;
}
.rt-btn:hover:not(:disabled){color:#fff;border-color:rgba(168,85,247,.55)}
.rt-btn:disabled{opacity:.3;cursor:default}
.rt-val{font-size:.8rem;color:var(--text);min-width:42px;text-align:center;font-weight:600}
.rt-progress{display:flex;align-items:center;gap:10px;font-size:.82rem;color:var(--muted)}
.rt-bar{width:110px;height:5px;border-radius:99px;background:#232329;overflow:hidden}
.rt-bar span{display:block;height:100%;width:0;background:var(--grad);transition:width .2s linear}

/* --- TOC : the "reading synapse" --- */
.toc{
  position:sticky;top:calc(var(--header-h) + 22px);
  max-height:calc(100vh - 140px);overflow:auto;
  background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);
  padding:18px 16px;
}
.toc-head{
  display:flex;justify-content:space-between;align-items:center;
  padding-bottom:12px;margin-bottom:12px;border-bottom:1px solid var(--border);
}
.toc-head .toc-title{display:flex;align-items:center;gap:9px;font-size:.95rem;font-weight:700;color:#fff}
.toc-title::before{content:'';width:8px;height:8px;border-radius:2px;background:var(--grad);transform:rotate(45deg)}
.toc-chip{
  font-size:.72rem;font-weight:700;padding:3px 11px;border-radius:99px;
  background:var(--grad-soft);border:1px solid rgba(168,85,247,.32);
}
.toc-list{list-style:none;margin:0;padding:8px 0;position:relative}
.toc-list::before{content:'';position:absolute;inset-inline-start:3px;top:14px;bottom:14px;width:2px;border-radius:2px;background:#26262c}
.toc-fill{position:absolute;inset-inline-start:3px;top:14px;width:2px;height:0;border-radius:2px;background:var(--grad);box-shadow:0 0 8px rgba(168,85,247,.7);transition:height .35s ease}
.toc-list a{
  position:relative;display:block;padding:7px 0 7px 0;padding-inline-start:22px;
  font-size:.86rem;line-height:1.7;color:var(--muted);transition:color .25s;
}
.toc-list a::before{
  content:'';position:absolute;inset-inline-start:0;top:50%;transform:translateY(-50%);
  width:10px;height:10px;border-radius:50%;background:#2f2f38;border:2px solid var(--bg);
  transition:background .25s,box-shadow .25s;
}
.toc-list a:hover{color:var(--text)}
.toc-list a.is-done::before{background:rgba(168,85,247,.45)}
.toc-list a.is-active{color:#fff;font-weight:600}
.toc-list a.is-active span{background:var(--grad);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.toc-list a.is-active::before{background:var(--purple);box-shadow:0 0 0 4px rgba(168,85,247,.16),0 0 12px rgba(168,85,247,.9)}
.toc-list a.lvl-3 span{padding-inline-start:13px}

/* --- Mobile TOC (collapsible) --- */
.toc-mobile{display:none;margin:0 0 34px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden}
.toc-mobile summary{
  display:flex;justify-content:space-between;align-items:center;cursor:pointer;
  padding:14px 18px;font-weight:700;color:#fff;font-size:.95rem;list-style:none;
}
.toc-mobile summary::-webkit-details-marker{display:none}
.toc-mobile .chev{transition:transform .3s;color:var(--muted)}
.toc-mobile[open] .chev{transform:rotate(180deg)}
.toc-mobile .toc-list{padding:2px 18px 14px}
.toc-mobile .toc-list::before,.toc-mobile .toc-fill{display:none}
.toc-mobile .toc-list li{border-bottom:1px dashed var(--border)}
.toc-mobile .toc-list li:last-child{border-bottom:0}
.toc-mobile .toc-list a{padding-inline-start:0;font-size:.9rem}
.toc-mobile .toc-list a::before{display:none}
.toc-mobile .toc-list a.is-active{color:#d8b4fe}

/* ============================================================
   7. Article Typography
============================================================ */
.post-body{
  font-size:calc(1.0625rem * var(--fs));
  line-height:2.05;color:var(--text-2);text-align:justify;
  overflow-wrap:break-word;
}
.post-body p{margin:0 0 1.4em}
.post-body strong{color:#fafafa;font-weight:700}
.post-body a{
  color:#c4b5fd;text-decoration:underline;text-underline-offset:4px;
  text-decoration-color:rgba(168,85,247,.45);transition:color .2s;
}
.post-body a:hover{color:#e9d5ff}
.post-body h2{
  font-size:1.55em;font-weight:800;color:#fafafa;line-height:1.55;
  margin:2.2em 0 .9em;position:relative;padding-inline-start:20px;scroll-margin-top:110px;
}
.post-body h2::before{
  content:'';position:absolute;inset-inline-start:0;top:.34em;height:.34em... 
}
.post-body h2::before{
  content:'';position:absolute;inset-inline-start:0;top:.35em;width:5px;border-radius:99px;
  height:1.15em;background:var(--grad);
}
.post-body h3{font-size:1.22em;font-weight:700;color:#f1f1f4;margin:1.8em 0 .7em;scroll-margin-top:110px}
.post-body ul{padding-inline-start:1.3em;margin:0 0 1.4em}
.post-body li{margin-bottom:.55em}
.post-body li::marker{color:var(--purple)}

/* Blockquote */
.post-body blockquote{
  position:relative;margin:2em 0;padding:24px 28px;overflow:hidden;
  background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);
}
.post-body blockquote::before{content:'';position:absolute;inset-inline-start:0;top:0;bottom:0;width:4px;background:var(--grad)}
.post-body blockquote p{font-size:1.05em;line-height:2.15;color:#dcdce3;margin:0}
.post-body blockquote cite{display:block;margin-top:12px;font-style:normal;font-size:.84em;color:var(--muted)}
.post-body blockquote cite::before{content:'— '}

/* Callouts */
.callout{display:flex;gap:14px;margin:1.8em 0;padding:18px 20px;border:1px solid;border-radius:var(--radius);text-align:start}
.callout svg{flex-shrink:0;margin-top:4px}
.callout .callout-title{font-weight:700;color:#fff;font-size:.95em;margin-bottom:3px}
.callout p{margin:0;font-size:.93em;line-height:1.95}
.callout.tip{background:rgba(168,85,247,.07);border-color:rgba(168,85,247,.28)}
.callout.tip svg{color:#c084fc}
.callout.warn{background:rgba(245,158,11,.07);border-color:rgba(245,158,11,.3)}
.callout.warn svg{color:#fbbf24}

/* Code block */
.code-card{direction:ltr;margin:2em 0;border:1px solid var(--border);border-radius:var(--radius);background:#0c0c10;overflow:hidden}
.code-head{display:flex;justify-content:space-between;align-items:center;padding:9px 16px;background:rgba(255,255,255,.03);border-bottom:1px solid var(--border)}
.code-title{font:600 .76rem/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;color:var(--muted);letter-spacing:.05em}
.copy-btn{
  display:inline-flex;align-items:center;gap:6px;cursor:pointer;
  font-size:.76rem;color:var(--text-2);background:rgba(255,255,255,.05);
  border:1px solid var(--border);border-radius:8px;padding:5px 11px;
  transition:color .2s,border-color .2s;
}
.copy-btn:hover{color:#fff;border-color:rgba(168,85,247,.55)}
.code-card pre{margin:0;padding:20px;overflow-x:auto;direction:ltr;text-align:left;
  font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
  font-size:.85em;line-height:2;color:#d4d4d8;
}
.tk-k{color:#c084fc}.tk-s{color:#86efac}.tk-c{color:#6b7280}.tk-f{color:#7dd3fc}

/* Table */
.table-wrap{overflow-x:auto;margin:2em 0;border:1px solid var(--border);border-radius:var(--radius)}
.table-wrap table{width:100%;min-width:560px;border-collapse:collapse;font-size:.9em;text-align:start}
.table-wrap th{background:var(--surface);color:#fff;font-weight:700;text-align:start;padding:13px 18px;border-bottom:1px solid var(--border-2)}
.table-wrap td{padding:13px 18px;border-bottom:1px solid var(--border)}
.table-wrap tr:last-child td{border-bottom:0}
.table-wrap tbody tr:hover{background:rgba(255,255,255,.02)}
.pill{display:inline-block;font-size:.72rem;padding:3px 12px;border-radius:99px;border:1px solid}
.pill.yes{color:#6ee7a0;border-color:rgba(110,231,160,.35);background:rgba(110,231,160,.08)}
.pill.no{color:#a1a1aa;border-color:var(--border-2);background:rgba(255,255,255,.04)}

/* Tags / Share / Author */
.tags{display:flex;flex-wrap:wrap;gap:10px;margin:2.6em 0 0}
.tag{
  font-size:.82rem;color:var(--text-2);background:var(--surface);
  border:1px solid var(--border);border-radius:99px;padding:6px 15px;cursor:pointer;
  transition:color .25s,border-color .25s,background .25s;
}
.tag:hover{color:#fff;border-color:rgba(168,85,247,.5);background:rgba(168,85,247,.08)}

.share{display:flex;align-items:center;gap:11px;margin-top:30px;padding-top:26px;border-top:1px dashed var(--border-2);flex-wrap:wrap}
.share-label{font-size:.88rem;font-weight:600;color:var(--muted);margin-inline-end:4px}
.share-btn{
  width:42px;height:42px;display:grid;place-items:center;border-radius:12px;cursor:pointer;
  background:var(--surface);border:1px solid var(--border);color:var(--text-2);
  transition:transform .25s,color .25s,border-color .25s,box-shadow .25s;
}
.share-btn:hover{transform:translateY(-3px);color:#fff;border-color:rgba(168,85,247,.5);box-shadow:0 10px 24px -10px rgba(168,85,247,.5)}

.author-box{
  position:relative;overflow:hidden;display:flex;gap:18px;align-items:flex-start;
  margin-top:44px;padding:24px;background:var(--surface);
  border:1px solid var(--border);border-radius:var(--radius);
}
.author-box::before{
  content:'';position:absolute;top:-70px;inset-inline-end:-70px;width:200px;height:200px;
  background:radial-gradient(circle,rgba(168,85,247,.16),transparent 70%);pointer-events:none;
}
.author-avatar{width:62px;height:62px;border-radius:50%;flex-shrink:0;display:grid;place-items:center;background:var(--grad);color:#fff;font-weight:800;font-size:1.5rem}
.author-box h3{margin:0 0 4px;font-size:1.02rem;color:#fff}
.author-box p{margin:0;font-size:.88rem;line-height:1.95;color:var(--muted);text-align:start}

/* ============================================================
   8. Related Articles (card language)
============================================================ */
.related{margin-top:96px;padding-bottom:96px}
.section-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:28px}
.section-title{display:flex;align-items:center;gap:12px;font-size:1.45rem;font-weight:800;color:#fafafa;margin:0}
.section-title::before{content:'';width:9px;height:9px;border-radius:3px;background:var(--grad);transform:rotate(45deg)}
.view-all{display:inline-flex;align-items:center;gap:6px;font-size:.88rem;color:var(--muted);transition:color .25s}
.view-all:hover{color:#fff}
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}

.card{
  position:relative;display:flex;flex-direction:column;
  background:var(--surface);border:1px solid var(--border);border-radius:18px;overflow:hidden;
  transition:transform .35s,border-color .35s,box-shadow .35s;
}
.card:hover{
  transform:translateY(-6px);border-color:rgba(168,85,247,.45);
  box-shadow:0 0 0 1px rgba(168,85,247,.2),0 26px 60px -24px rgba(168,85,247,.35);
}
.card.flash{animation:flashRing 1.6s ease-out}
@keyframes flashRing{0%{box-shadow:0 0 0 0 rgba(168,85,247,.65)}100%{box-shadow:0 0 0 26px rgba(168,85,247,0)}}
.card-media{position:relative;aspect-ratio:16/10;overflow:hidden}
.card-media img{width:100%;height:100%;object-fit:cover;transition:transform .6s cubic-bezier(.2,.7,.2,1)}
.card:hover .card-media img{transform:scale(1.07)}
.card-badge{
  position:absolute;top:12px;inset-inline-start:12px;
  display:inline-flex;align-items:center;gap:6px;
  font-size:.74rem;font-weight:600;color:#fff;
  background:rgba(9,9,11,.72);backdrop-filter:blur(8px);
  border:1px solid rgba(255,255,255,.15);border-radius:99px;padding:5px 13px;
}
.card-badge::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--grad)}
.card-body{display:flex;flex-direction:column;gap:10px;padding:20px;flex:1}
.card-meta{display:flex;gap:16px;font-size:.77rem;color:var(--muted)}
.card-meta span{display:inline-flex;align-items:center;gap:6px}
.card-title{margin:0;font-size:1.02rem;font-weight:700;line-height:1.75}
.card-title a{color:#f1f1f4;transition:color .25s}
.card-title a:hover{color:#fff}
.card-title a::after{content:'';position:absolute;inset:0}
.card-excerpt{
  margin:0;font-size:.86rem;line-height:1.95;color:var(--muted);
  display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;
}

/* ============================================================
   9. Footer
============================================================ */
.site-footer{position:relative;border-top:1px solid var(--border);background:#0b0b0e;overflow:hidden}
.site-footer::before{
  content:'';position:absolute;top:-140px;inset-inline-start:50%;transform:translateX(50%);
  width:640px;height:280px;background:radial-gradient(closest-side,rgba(168,85,247,.09),transparent);
  pointer-events:none;
}
.footer-grid{position:relative;display:grid;grid-template-columns:1.6fr 1fr 1fr;gap:48px;padding:60px 0 46px}
.footer-about p{font-size:.9rem;line-height:2.1;color:var(--muted);margin:18px 0 20px;max-width:42ch}
.socials{display:flex;gap:10px}
.footer-col h3{
  position:relative;font-size:.95rem;font-weight:700;color:#fff;margin:0 0 18px;padding-inline-start:15px;
}
.footer-col h3::before{content:'';position:absolute;inset-inline-start:0;top:.28em;width:4px;height:1em;border-radius:99px;background:var(--grad)}
.footer-col a{
  display:flex;align-items:center;gap:8px;width:fit-content;
  padding:6px 0;font-size:.9rem;color:var(--muted);
  transition:color .25s,transform .25s;
}
.footer-col a:hover{color:#fff;transform:translateX(-4px)}
.footer-bottom{
  display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;
  border-top:1px solid var(--border);padding:20px 0;font-size:.85rem;color:var(--muted);
}
.footer-domain{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.78rem;letter-spacing:.05em;transition:color .25s}
.footer-domain:hover{color:var(--purple)}

/* ============================================================
   10. Floating UI: to-top + toasts
============================================================ */
.to-top{
  position:fixed;bottom:26px;inset-inline-end:26px;z-index:900;
  width:46px;height:46px;display:grid;place-items:center;cursor:pointer;
  background:rgba(19,19,22,.85);backdrop-filter:blur(10px);
  border:1px solid var(--border-2);border-radius:13px;color:var(--text-2);
  opacity:0;pointer-events:none;transform:translateY(14px);
  transition:opacity .3s,transform .3s,border-color .25s,box-shadow .25s;
}
.to-top.show{opacity:1;pointer-events:auto;transform:none}
.to-top:hover{color:#fff;border-color:rgba(168,85,247,.6);box-shadow:0 0 22px -6px rgba(168,85,247,.6)}

.toasts{position:fixed;bottom:24px;inset-inline-start:24px;z-index:1300;display:flex;flex-direction:column;gap:10px;max-width:min(360px,calc(100vw - 48px))}
.toast{
  position:relative;display:flex;align-items:center;gap:11px;overflow:hidden;
  background:rgba(19,19,22,.94);backdrop-filter:blur(12px);
  border:1px solid var(--border-2);border-radius:12px;padding:13px 18px 13px 16px;
  font-size:.87rem;color:var(--text);
  box-shadow:0 18px 44px -14px rgba(0,0,0,.8);
  animation:toastIn .35s cubic-bezier(.2,.9,.3,1.15) both;
}
.toast::before{content:'';position:absolute;inset-inline-start:0;top:0;bottom:0;width:3px;background:var(--grad)}
.toast.out{animation:toastOut .3s ease forwards}
.toast .dot{width:8px;height:8px;border-radius:50%;background:var(--grad);flex-shrink:0}
@keyframes toastIn{from{opacity:0;transform:translateY(16px) scale(.96)}to{opacity:1;transform:none}}
@keyframes toastOut{to{opacity:0;transform:translateY(10px)}}

/* Reveal on scroll */
.reveal{opacity:0;transform:translateY(24px);transition:opacity .7s ease,transform .7s ease;transition-delay:var(--d,0s)}
.reveal.in{opacity:1;transform:none}

/* ============================================================
   11. Responsive
============================================================ */
@media (max-width:1079px){
  .main-nav{display:none}
  .menu-toggle{display:block}
  .post-layout{grid-template-columns:1fr;gap:0}
  .post-sidebar{display:none}
  .toc-mobile{display:block}
}
@media (max-width:900px){
  .cards{grid-template-columns:repeat(2,1fr)}
  .footer-grid{grid-template-columns:1fr 1fr;gap:40px}
  .footer-about{grid-column:1/-1}
}
@media (max-width:760px){
  .header-search{display:none}
  .post-cover img{aspect-ratio:16/10}
  .rt-progress{width:100%;justify-content:space-between}
  .rt-bar{flex:1}
}
@media (max-width:600px){
  .cards{grid-template-columns:1fr}
  .footer-grid{grid-template-columns:1fr}
  .post-meta{gap:12px}
  .meta-sep{display:none}
  .to-top{bottom:18px;inset-inline-end:18px}
}

/* Reduced motion */
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}
  html{scroll-behavior:auto}
  .reveal{opacity:1;transform:none}
}
