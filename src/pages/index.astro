          </div>
          <figcaption>هوش مصنوعی دیگر آینده نیست؛ بخشی از زندگی امروز ماست — تصویر: مغزه</figcaption>
        </figure>
      </div>
    </div>

    <!-- Body + TOC -->
    <div class="container">
      <div class="post-layout">

        <div class="post-body" id="postBody">

          <!-- Reader tools -->
          <div class="reading-tools">
            <div class="rt-group" role="group" aria-label="تنظیم اندازهٔ متن">
